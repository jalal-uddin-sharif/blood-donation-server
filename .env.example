PORT=3001
API_SECRET_KEY=replace_with_a_long_random_jwt_secret

# Option 1: paste your full MongoDB Atlas connection string here in your local .env only.
# Do not commit a real MongoDB URI because it contains database credentials.
MONGODB_URI=replace_with_your_mongodb_atlas_connection_string

# Option 2: keep these if you use the hardcoded Cluster0 host in index.js.
DATABASE_ACCESS_USERNAME=replace_with_database_username
DATABASE_ACCESS_PASSWORD=replace_with_database_password

# Comma-separated frontend origins allowed by CORS.
CLIENT_ORIGINS=http://localhost:5173,https://red-love-donation.web.app,https://red-love-donation.firebaseapp.com
